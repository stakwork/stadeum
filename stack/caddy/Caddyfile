# stadeum's router: TLS and the three sites, the only published ports.
# SCHEME, HOST and ACME_EMAIL come from stack/stadeum.yml (stack/dev.yml:
# plain http on *.localhost). With https, Caddy fetches and renews the
# certificates itself.
{
	email "{$ACME_EMAIL}"
	# No HTTP/3. Over QUIC, Caddy 2.11.8 sometimes cannot deliver a
	# response to a browser: the write stalls until its write idle timeout
	# (a minute), then every later response on that connection fails the
	# same way ("aborting with incomplete response ... writing: deadline
	# exceeded"). The app frame then shows "Request timed out". HTTP/2
	# never did this (2026-11-26).
	servers {
		protocols h1 h2
	}
}

# stadeum-ui: sign-in, the person, calls, the members, the admin pages.
{$SCHEME}://{$HOST} {
	# Routes for the box's network only, never through here: ops's (settings
	# with the backup credentials, its status) and strut's (a grant's model
	# key, /api/mothership/keys; a person's token refreshed by the connect
	# seam, /api/connect/<provider>/refresh).
	respond /api/ops/* 404
	respond /api/mothership/* 404
	respond /api/connect/*/refresh 404
	reverse_proxy stadeum-ui:3000
}

# strut: its API and the UI stadeum-ui frames. A subdomain of HOST, so the
# two are the same site and strut's session cookie reaches the frame.
{$SCHEME}://strut.{$HOST} {
	reverse_proxy strut:3000 {
		# Run tails and the chat are SSE: pass every chunk on at once.
		# WebSocket upgrades (/rooms, /channels, /audio/stream) pass as is.
		flush_interval -1
	}
}

# The gateway, for a machine outside the box that strut grants model calls
# (a pod's apps): the providers' own endpoints and nothing else, so a
# standard SDK works with a base URL and a key. Its admin API (/api/*), its
# plugin's routes (/_plugin/*) and its dashboard are never routed here.
# Caddy cleans the path before it matches, so `..` cannot step out of them.
# The key is `<virtual key>.<macaroon>`: the gateway itself splits it into
# the key's own header and `x-macaroon` (mothership wrapper/authsplit.go),
# and refuses a call without both, as on the box's network. docs/models.md,
# "A grant's key".
#
# Also the gateway's two issuer documents, for Anthropic to check the
# identity tokens it signs (docs/models.md, "Anthropic without a key"):
# public keys only, and nothing else under /.well-known/.
{$SCHEME}://mothership.{$HOST} {
	@provider path /openai/* /anthropic/* /genai/*
	handle @provider {
		reverse_proxy bifrost:8181 {
			# Streamed completions: pass every chunk on at once.
			flush_interval -1
		}
	}
	@issuer path /.well-known/openid-configuration /.well-known/mothership-jwks.json
	handle @issuer {
		reverse_proxy bifrost:8181
	}
	respond 404
}
