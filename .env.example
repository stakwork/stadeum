# Copy with scripts/init-env.sh (generates the secrets below into .env and
# never overwrites a value already set). Used with:
#   docker compose --env-file .env -f stack/stadeum.yml [-f stack/dev.yml] up -d
# This file is the box's own: a release never writes it (nor stack/local.yml,
# the box's compose override).

# Public hostname: stadeum-ui at $HOST, strut at strut.$HOST (the same site,
# which the strut frame needs). Local: keep stadeum.localhost with
# stack/dev.yml (plain http; every *.localhost is this machine).
HOST=stadeum.localhost
# Let's Encrypt account email (production; blank is accepted).
ACME_EMAIL=
# Host ports caddy publishes (the only published ports).
HTTP_PORT=80
HTTPS_PORT=443

# --- Generated by scripts/init-env.sh ---
# Every backup keeps this file with the volumes (the Backups page): the data
# is unreadable without NEO4J_PASSWORD, STRUT_SECRET_KEY and
# STADEUM_ENCRYPTION_KEY. The backups' own password is not here: stadeum-ui
# makes it and shows it once, for the admin to keep off the box.
NEO4J_PASSWORD=
BIFROST_ADMIN_PASS=
# The deployment key: bifrost BIFROST_PROVISIONING_TOKEN and strut
# STRUT_API_KEY. It never reaches a browser.
SHARED_API_TOKEN=
# 32 bytes hex. Encrypts strut's secret stores (secrets.json and the
# delegations in mothership.json). Losing it loses what they hold.
STRUT_SECRET_KEY=
# The path of strut-browser's one door; strut alone knows it.
BROWSER_WS_PATH=
# 32 bytes hex. Encrypts the org signing key in the `org` volume and
# stadeum-ui's secrets at rest. Losing it means re-keying the org.
STADEUM_ENCRYPTION_KEY=
# The secret strut and the voice service share: only strut starts a call
# (strut STRUT_VOICE_TOKEN). A box from before calls gets it by running the
# installer again (scripts/install.sh, which runs init-env.sh: a box has no
# scripts/ of its own).
STRUT_VOICE_TOKEN=
# The treasury's tokens (the Sphinx daemon, strut's Lightning wallet;
# plans/treasury.md), three different values. The receive token makes
# invoices and reads the balance; the pay token also pays (a withdrawal from
# strut's Earnings); strut gets both. The admin token, which can post and
# join tribes as the account, goes to the treasury alone. Without all three
# the treasury waits and strut has no wallet; a box from before the
# treasury gets them by running the installer again (scripts/install.sh).
DAEMON_ADMIN_TOKEN=
DAEMON_RECEIVE_TOKEN=
DAEMON_PAY_TOKEN=

# stadeum-ui session signing (Auth.js).
AUTH_SECRET=

# --- stadeum-ui sign-in (a provider shows as usable only when its id is set) ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# For boxes under one domain that share one sign-in callback: the bounce's
# https origin (e.g. https://auth.example.com), whose callbacks Google and
# Microsoft have instead of this box's (docs/stack-spec.md, "Sign-in
# through a bounce"). Blank: the providers come back to this box.
STADEUM_SIGNIN_BOUNCE=
# Comma-separated email domains that may sign in without an invite.
STADEUM_ALLOWED_DOMAINS=
# The first admin's email. Set, this person becomes admin by signing in
# while the box has no admin, and nobody else can: whoever arrives first
# needs an invite or an allowed domain like anyone else. Blank: the first
# person to sign in becomes admin.
STADEUM_ADMIN_EMAIL=
# Shown beside the wordmark.
STADEUM_ORG_NAME=

# --- Org identity (stack/bootstrap) ---
# Macaroon org_id becomes stadeum_<slug>; bifrost realm_id is the slug.
STADEUM_ORG_SLUG=org
# Trust-registry issuer_url (stadeum-ui's public URL). Blank is accepted.
STADEUM_ISSUER_URL=

# --- Models ---
# Provider keys are not set here: an admin sets each on stadeum's Models
# page, which writes it to bifrost and nowhere else (docs/models.md).
# A host that pays for this box's models gives them here instead: a JSON
# list of { provider, key, url? }, single-quoted. provider is one of
# anthropic, openai, gemini, xai, openrouter; url, when set, is where its
# calls go instead of the provider (an upstream gateway, a company's proxy).
# stadeum-ui writes each into the gateway at start and every six hours, and
# the Models page shows it as given and doesn't change it (docs/models.md,
# "Providers given at install", also says how to take one back).
# STADEUM_MODEL_PROVIDERS='[{"provider":"anthropic","key":"sk-…","url":"https://models.example.com/anthropic"}]'
# Blank: none.
STADEUM_MODEL_PROVIDERS=
# Optional, strut's: web search on a call routed through bifrost.
EXA_API_KEY=

# --- Calls (the Calls page; docs/stack-spec.md, "voice") ---
# A person's voice call with the assistant goes through a LiveKit server,
# end-to-end encrypted with a key their browser makes for each call: the
# server carries audio it cannot read. The box reaches it outbound only.
# Any LiveKit server works; blank is the central one, wss://livekit.sphinx.chat.
LIVEKIT_URL=
# That server's API key and secret. Calls are off until both are set (and
# STRUT_VOICE_TOKEN): the box runs without them, and the Calls page says so.
# A LiveKit key is admin over every room on its server, so keep it as close
# as STRUT_SECRET_KEY.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Backups given at install ---
# Blank (the usual): an admin picks where backups go on the Backups page,
# and the box makes the backups' password. A host that keeps the box's
# backups for it gives the destination here instead, as the Backups page's
# fields with the kind (s3, azure, gcs, b2, local), single-quoted JSON:
# STADEUM_BACKUP_DESTINATION='{"kind":"s3","bucket":"…","path":"boxes/acme","region":"us-east-1","accessKeyId":"…","secretAccessKey":"…"}'
# stadeum-ui writes it into the backup settings, with backups on, at start
# and every six hours; the Backups page shows it as given and doesn't
# change it (docs/stack-spec.md, "Backups given at install").
STADEUM_BACKUP_DESTINATION=
# The backups' password, at least 16 characters, so the host can keep a
# copy. Used only if the box has none yet: a repository keeps the password
# it was made with. Blank: the box makes its own. The Backups page still
# shows it to the admin, with the restore kit, until they keep it.
STADEUM_BACKUP_PASSWORD=

# --- Packages ---
# Packages strut installs at first boot: a JSON list of { ref, url?, digest? }
# (strut's STRUT_PACKAGES, specs/API.md §16). A package already installed is
# left alone, so this never updates one; a failed install is tried again at
# the next boot and never stops the box. Single-quote the value. A ref is a
# package name, resolved through the package indexes strut follows (strut's
# built-in default, or STRUT_PACKAGE_INDEXES):
# STRUT_PACKAGES='[{"ref":"stakwork/legal-desk"}]'
# A package no index lists: {"ref":"pk:<publisher key>/<publisher>/<name>","url":"<its public catalog>"}.
# Blank: none. After boot, admins install from the Packages page instead.
STRUT_PACKAGES=

# --- Optional ---
# STRUT_MOTHERSHIP(_REQUIRED) and BIFROST_PLUGIN_ENFORCE_{MACAROONS,BUDGETS}
# are fixed on in stack/stadeum.yml; values here are ignored.
#
# Images. Blank = stack/stadeum.yml's defaults.
# strut and strut-browser: default `stable`, the channel strut's promote
# workflow moves for both at once; ops follows it in the nightly window. A
# commit tag (STRUT_IMAGE_TAG=2fe953a) pins strut, and then STRUT_BROWSER_TAG
# must be the Playwright version that commit pins (e.g. 1.63.0).
STRUT_IMAGE_TAG=
STRUT_BROWSER_TAG=
# stadeum-ui and ops: default `stable`, stadeum's channel
# (.github/workflows/promote-images.yml): its release, with the stack files
# ops's image carries, which ops follows too. A short commit sha pins both.
# stack/dev.yml builds them from this checkout instead.
STADEUM_IMAGE_TAG=
# The gateway: blank follows the release's pin (stack/stadeum.yml, v0.4.399);
# a tag here pins this box's (stakgraph's releases).
BIFROST_TAG=
# Maple's inference proxy: blank follows the release's pin (0.4.5); a tag
# here pins this box's.
MAPLE_PROXY_TAG=
# The voice service (sphinx-voice, Docker Hub): blank follows its `stable`
# channel, moved with strut (scripts/promote.sh voice); a release's tag
# (0.43) here pins this box's.
VOICE_TAG=
# The treasury (ghcr.io/stakwork/sphinx-daemon): blank follows its `stable`
# channel, moved with strut (scripts/promote.sh daemon); a commit tag
# (b31014c) here pins this box's.
TREASURY_TAG=
# Neo4j memory (laptop defaults).
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=1g
NEO4J_TX_TOTAL_MAX=1g
NEO4J_TX_MAX=512m
