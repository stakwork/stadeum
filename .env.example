# Copy with scripts/init-env.sh (generates the secrets below into .env and
# never overwrites a value already set). Used with:
#   docker compose --env-file .env -f stack/stadeum.yml [-f stack/dev.yml] up -d

# Public hostname. Services route at <svc>.$HOST (repo2graph, bifrost);
# stadeum-ui at $HOST. stack/dev.yml ignores it and uses *.localhost.
HOST=localhost
# Let's Encrypt account email (production only).
ACME_EMAIL=
# Host ports traefik publishes (the only published ports).
HTTP_PORT=80
HTTPS_PORT=443

# --- Generated by scripts/init-env.sh ---
NEO4J_PASSWORD=
BIFROST_ADMIN_PASS=
# Replaces boltwall's stakwork_secret: bifrost BIFROST_PROVISIONING_TOKEN,
# repo2graph API_TOKEN (and so the lab strut's STRUT_SECRET_KEY).
SHARED_API_TOKEN=
# 32 bytes hex. Encrypts the org signing key in the `org` volume and
# stadeum-ui's secrets at rest. Losing it means re-keying the org.
STADEUM_ENCRYPTION_KEY=

# stadeum-ui session signing (Auth.js).
AUTH_SECRET=

# --- stadeum-ui sign-in (a provider shows as usable only when its id is set) ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated email domains that may sign in without an invite.
STADEUM_ALLOWED_DOMAINS=
# Shown beside the wordmark.
STADEUM_ORG_NAME=

# --- Org identity (stack/bootstrap) ---
# Macaroon org_id becomes stadeum_<slug>; bifrost realm_id is the slug.
STADEUM_ORG_SLUG=org
# Trust-registry issuer_url (stadeum-ui's public URL). Blank is accepted.
STADEUM_ISSUER_URL=

# --- Provider keys (fill in; blank = not configured) ---
# Passed to bifrost only. repo2graph gets a placeholder (stack/stadeum.yml).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
EXA_API_KEY=
# GitHub token repo2graph uses for clones (PAT).
GITHUB_REQUEST_TOKEN=

# --- Optional ---
LLM_PROVIDER=anthropic
STRUT_CHAT_MODEL=
STRUT_LLM_MODEL=
# STRUT_MOTHERSHIP_REQUIRED and BIFROST_PLUGIN_ENFORCE_{MACAROONS,BUDGETS}
# are fixed on in stack/stadeum.yml; values here are ignored.
# Image tags for the GHCR images (no versioned tags are published yet).
REPO2GRAPH_TAG=latest
BIFROST_TAG=latest
# Neo4j memory (swarm production: 6g/6g/8g/4g/1g).
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=1g
NEO4J_TX_TOTAL_MAX=1g
NEO4J_TX_MAX=512m
NEO4J_CHECKPOINT_IOPS=500
