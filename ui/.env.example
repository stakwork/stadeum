# SQLite file. In the container it lives in the /data volume.
DATABASE_URL=file:./dev.db

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Identity providers. A provider is offered only when its id is set.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# A sign-in bounce shared by boxes under one domain, https only
# (docs/stack-spec.md, "Sign-in through a bounce"). Blank: none.
STADEUM_SIGNIN_BOUNCE=

# Email-only sign-in for local development. Never set in production.
STADEUM_DEV_LOGIN=

# A GitHub App for the connect seam (docs/stack-spec.md, "The connect
# seam"). Blank: GitHub can't be connected. `npm run fake-stack` prints all
# four for its fake GitHub; CONNECT_GITHUB_URL (default https://github.com)
# is GitHub's address, set only for the fake: a box never hands it over.
CONNECT_GITHUB_CLIENT_ID=
CONNECT_GITHUB_CLIENT_SECRET=
CONNECT_GITHUB_SLUG=
CONNECT_GITHUB_URL=

# A Google OAuth client for the connect seam, never the sign-in's
# (AUTH_GOOGLE_*). Blank: Google can't be connected. `npm run fake-stack`
# prints all three for its fake Google; CONNECT_GOOGLE_URL puts Google's
# two URLs under the fake's, and a box never hands it over.
CONNECT_GOOGLE_CLIENT_ID=
CONNECT_GOOGLE_CLIENT_SECRET=
CONNECT_GOOGLE_URL=
# Strut's bearer on the connect seam's refresh route. Blank: the route is a 404.
CONNECT_TOKEN=

# Comma-separated email domains that may sign in without an invite.
STADEUM_ALLOWED_DOMAINS=

# The first admin's email: only this person becomes admin by signing in
# while there is no admin. Blank: the first person to sign in does.
STADEUM_ADMIN_EMAIL=

# A backup destination the box's host gives (JSON of the Backups page's
# fields, with the kind), and optionally its password (docs/stack-spec.md,
# "Backups given at install"). Blank: an admin picks one.
STADEUM_BACKUP_DESTINATION=
STADEUM_BACKUP_PASSWORD=

# 32 bytes, hex (openssl rand -hex 32). Encrypts private keys and virtual keys at rest.
STADEUM_ENCRYPTION_KEY=

# Macaroon org id becomes stadeum_<slug>.
STADEUM_ORG_SLUG=acme
# Shown beside the wordmark and on the sign-in page.
STADEUM_ORG_NAME=

# The deployment key: bifrost's provisioning token and strut's STRUT_API_KEY.
SHARED_API_TOKEN=

# Internal URLs on the docker network.
BIFROST_URL=http://bifrost:8181
BIFROST_ADMIN_USER=admin
BIFROST_ADMIN_PASS=
STRUT_URL=http://strut:3000
NEO4J_HTTP_URL=http://neo4j:7474

# Where the browser loads strut's UI from, in the frame: strut.<AUTH_URL's
# host>, so the two are the same site. Blank = STRUT_URL.
STRUT_PUBLIC_URL=

# Providers the box's host gives: a JSON list of { provider, key, url? }
# (docs/models.md, "Providers given at install"). Blank: none.
STADEUM_MODEL_PROVIDERS=

# Optional: cumulative per-person spend ceiling on the Strut delegation (USD).
STRUT_DELEGATION_MAX_COST_USD=
