# SQLite file. In the container it lives in the /data volume.
DATABASE_URL=file:./dev.db

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Identity providers. A provider is offered only when its id is set.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Providers the box's host gives: a JSON list of { provider, key, url? }
# (docs/models.md, "Providers given at install"). Blank: none.
STADEUM_MODEL_PROVIDERS=

# Email-only sign-in for local development. Never set in production.
STADEUM_DEV_LOGIN=

# Comma-separated email domains that may sign in without an invite.
STADEUM_ALLOWED_DOMAINS=

# The first admin's email: only this person becomes admin by signing in
# while there is no admin. Blank: the first person to sign in does.
STADEUM_ADMIN_EMAIL=

# 32 bytes, hex (openssl rand -hex 32). Encrypts private keys and virtual keys at rest.
STADEUM_ENCRYPTION_KEY=

# Macaroon org id becomes stadeum_<slug>.
STADEUM_ORG_SLUG=acme
# Shown beside the wordmark and on the sign-in page.
STADEUM_ORG_NAME=

# The deployment key: bifrost's provisioning token and strut's STRUT_API_KEY.
SHARED_API_TOKEN=

# Internal URLs on the docker network.
BIFROST_URL=http://bifrost:8181
BIFROST_ADMIN_USER=admin
BIFROST_ADMIN_PASS=
STRUT_URL=http://strut:3000
NEO4J_HTTP_URL=http://neo4j:7474

# Where the browser loads strut's UI from, in the frame: strut.<AUTH_URL's
# host>, so the two are the same site. Blank = STRUT_URL.
STRUT_PUBLIC_URL=

# Optional: cumulative per-person spend ceiling on the Strut delegation (USD).
STRUT_DELEGATION_MAX_COST_USD=
