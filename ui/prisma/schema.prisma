generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person who can sign in. The first one becomes admin.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  /// admin | member (lib/roles.ts)
  role      String   @default("member")
  /// Stable Strut actor and Bifrost customer name: `<email-local>-<id>`.
  actor     String   @unique
  createdAt DateTime @default(now())
  lastSeenAt DateTime?

  mothership MothershipUser?
  invitesSent Invite[] @relation("InvitedBy")
}

model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        String    @default("member")
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
}

/// The one org this install serves: its macaroon signing key and trust state.
model Org {
  id                  String    @id @default("org")
  macaroonOrgId       String?
  orgPubkey           String?
  /// AES-256-GCM, see lib/crypto.ts
  orgPrivkeyEnc       String?
  bifrostAdminUser    String?
  bifrostAdminPassEnc String?
  trustedPubkey       String?
  trustRegisteredAt   DateTime?
  /// The models people may use: a JSON list of strut's canonical names
  /// (`anthropic/claude-sonnet-5-5`). Null until an admin saves one: then
  /// every model of every provider with a key (docs/models.md).
  models              String?
  /// The model everyone gets unless they pick one; one of `models`.
  defaultModel        String?
  /// Prices the admin typed for models strut has no rate for (an Other
  /// provider's): JSON `{ "<provider>/<id>": { input, output } }`, USD per
  /// million tokens. Pushed to the gateway's price table.
  modelPrices         String?
  updatedAt           DateTime  @updatedAt
}

/// Per-person mothership identity: ed25519 key, Bifrost customer + VK, delegation.
model MothershipUser {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPubkey       String?
  userPrivkeyEnc   String?
  customerId       String?
  vkId             String?
  vkValueEnc       String?
  delegationId     String?
  delegationExp    DateTime?
  /// fresh | pushed | unsupported | failed | not-configured
  delegationStatus String?
  delegationError  String?
  checkedAt        DateTime?
}

/// Last result of each status-page check.
model HealthCheck {
  name      String   @id
  ok        Boolean
  detail    String
  checkedAt DateTime
}

/// The box's upkeep, which `ops` reads (one row). docs/stack-spec.md, "ops".
model OpsSettings {
  id             String   @id @default("ops")
  /// The daily window, HH:MM in timeZone (IANA).
  windowStart    String   @default("03:00")
  windowEnd      String   @default("05:00")
  timeZone       String   @default("UTC")
  /// How long to wait for strut to go idle before a restart.
  drainMinutes   Int      @default(30)
  updatesEnabled Boolean  @default(true)
  backupsEnabled Boolean  @default(true)
  /// s3 | azure | gcs | b2 | local (lib/ops/destination.ts); null until the admin picks one.
  backupKind     String?
  /// The destination's fields that are not secret, JSON.
  backupFields   String?
  /// Its credentials, JSON, AES-256-GCM (lib/crypto.ts).
  backupSecretsEnc  String?
  /// restic's password, AES-256-GCM. Made once, with the first destination.
  resticPasswordEnc String?
  /// When the admin said they keep the password off the box; the Backups page shows it until then.
  passwordKeptAt DateTime?
  updatedAt      DateTime @updatedAt
}

/// What ops last said it is doing (one row): ui/src/lib/ops/contract.ts, OpsStatus.
model OpsStatus {
  id         String   @id @default("ops")
  /// The OpsStatus, JSON, without `done`.
  state      String
  /// The window ops last ran its daily pass in.
  lastCycle  String?
  reportedAt DateTime
}

/// An admin's Check now, Update now or Back up now, until ops says it is done.
model OpsRequest {
  id        String    @id @default(cuid())
  /// check | update | backup
  kind      String
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

/// What ops did: an update, a rollback, a backup, a restore.
model OpsEvent {
  id         String   @id @default(cuid())
  /// update | backup | restore
  kind       String
  /// ok | failed | rolled-back | skipped
  outcome    String
  startedAt  DateTime
  endedAt    DateTime
  detail     String
  /// OpsEvent.changes, JSON.
  changes    String?
  snapshotId String?
  createdAt  DateTime @default(now())

  @@index([kind, endedAt])
}
